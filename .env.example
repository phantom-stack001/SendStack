# --- SendStack API (server only — never use VITE_ prefix for secrets) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require



BETTER_AUTH_SECRET=generate-a-random-string-at-least-32-characters-long
# Public URL the browser uses (Vite dev server or production site origin)

BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173


PORT=3001


AUTH_EMAIL_DELIVERY=console

# One-time database reset (CLI only). Requires explicit confirmation:
# SENDSTACK_DB_RESET_CONFIRM=yes npm run db:reset
#
# One-time super-admin bootstrap (never commit the password):
# BOOTSTRAP_ADMIN_EMAIL=roux.thomas@ctn-sk.com
# BOOTSTRAP_ADMIN_NAME=Thomas Roux
# BOOTSTRAP_ADMIN_PASSWORD=   # server-only, omit from committed .env.example

# Optional SMTP settings when AUTH_EMAIL_DELIVERY=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Optional explicit frontend origin for the auth client (defaults to window.location.origin)
# VITE_APP_URL=http://localhost:5173

# --- Phase 7 queue (server only — requires Redis protocol, not HTTP Redis APIs) ---
# QUEUE_ENABLED=false
# QUEUE_SIMULATION_ONLY=true
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_WORKER_CONCURRENCY=2
# QUEUE_MAX_JOBS_PER_SECOND=5
# QUEUE_MAX_ATTEMPTS=3
# QUEUE_JOB_RETENTION_DAYS=7
# QUEUE_SIMULATION_DELAY_MS=25
