# Shared / Vercel production (web/)
# Prefer web/.env.example when working inside the Next.js app.
DATABASE_URL=postgres://user:password@host:5432/sendstack?sslmode=require
SENDSTACK_PUBLIC_URL=http://localhost:3000
SENDSTACK_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

SENDSTACK_FROM_EMAIL=news@example.com
SENDSTACK_REPLY_TO_EMAIL=hello@example.com
SENDSTACK_COMPANY_NAME=
SENDSTACK_POSTAL_ADDRESS=
SENDSTACK_ALLOWED_LINK_DOMAINS=example.com,www.example.com
SENDSTACK_TEST_RECIPIENT_ALLOWLIST=

SENDSTACK_HEALTH_MIN_SAMPLE=50
SENDSTACK_HEALTH_MAX_BOUNCE_RATE=0.05
SENDSTACK_HEALTH_MAX_COMPLAINT_RATE=0.001
SENDSTACK_HEALTH_MAX_UNSUBSCRIBE_RATE=0.02
SENDSTACK_HEALTH_MAX_DELAY_RATE=0.2
SENDSTACK_HEALTH_MAX_FAILURE_RATE=0.05
SENDSTACK_EMERGENCY_STOP=false

SENDSTACK_LIVE_SEND_ENABLED=false
SENDSTACK_COOKIE_SECURE=false
SENDSTACK_SESSION_HOURS=12
SENDSTACK_DAILY_LIMIT=50
SENDSTACK_ADMIN_EMAIL=admin@sendstack.local
SENDSTACK_ADMIN_PASSWORD=ChangeMe123!

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
