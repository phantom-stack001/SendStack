{
  "name": "sendstack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:worker": "tsx server/workers/email-processing.worker.ts",
    "dev:dispatcher": "tsx server/dispatchers/campaign-dispatcher.ts",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:server": "tsc -p tsconfig.server.build.json",
    "preview": "vite preview",
    "start:api": "node dist-server/index.js",
    "start:dispatcher": "node dist-server/dispatchers/campaign-dispatcher.js",
    "start:worker": "node dist-server/workers/email-processing.worker.js",
    "start:server": "npm run start:api",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "queue:reconcile": "tsx server/scripts/queue-reconcile.ts",
    "queue:check": "tsx server/scripts/queue-check.ts",
    "queue:check:production": "tsx server/scripts/queue-check.ts --production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:inspect": "tsx server/scripts/inspect-database.ts",
    "db:reset": "tsx server/scripts/reset-sendstack-db.ts",
    "admin:bootstrap": "tsx server/scripts/bootstrap-admin.ts",
    "mail:check": "tsx server/scripts/mail-check.ts",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./server/auth/auth.ts --output ./server/db/schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hono/node-server": "^2.1.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/html": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "imapflow": "^2.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.54.0",
    "mailparser": "^3.9.37",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.17.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
