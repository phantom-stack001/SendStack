{
  "name": "sendstack-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/stamp-assets.mjs && next build && node scripts/stamp-assets.mjs --reset",
    "stamp-assets": "node scripts/stamp-assets.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "vitest run tests/pg-safety.test.ts tests/pg-migrate.test.ts tests/pg-migration-safety.test.ts tests/pg-launch-safety.test.ts tests/pg-integration.test.ts"
  },
  "dependencies": {
    "@next/env": "15.5.24",
    "next": "15.5.24",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldts": "^7.4.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
