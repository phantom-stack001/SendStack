# Copy to .env.local for local development. Never commit real secrets.
# Preview deployments must NOT receive production Resend credentials.

# Dedicated disposable Postgres for destructive integration tests (never falls back to DATABASE_URL).
# Database name must include `_test` (e.g. sendstack_test) or append ?sendstack_disposable=1
# SENDSTACK_TEST_DATABASE_URL=postgresql://sendstack:sendstack@127.0.0.1:55432/sendstack_test
SENDSTACK_PUBLIC_URL=http://localhost:3000
SENDSTACK_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Enforced monitored sender identity (required before live sending)
SENDSTACK_FROM_EMAIL=news@example.com
SENDSTACK_REPLY_TO_EMAIL=hello@example.com
SENDSTACK_COMPANY_NAME=
SENDSTACK_POSTAL_ADDRESS=
# Comma-separated hosts allowed in campaign HTTP(S) links (not public suffixes)
SENDSTACK_ALLOWED_LINK_DOMAINS=example.com,www.example.com
# Exact addresses permitted for administrator test sends
SENDSTACK_TEST_RECIPIENT_ALLOWLIST=

# Delivery health thresholds (required before live sending). Rates are 0..1 ratios.
SENDSTACK_HEALTH_MIN_SAMPLE=50
SENDSTACK_HEALTH_MAX_BOUNCE_RATE=0.05
SENDSTACK_HEALTH_MAX_COMPLAINT_RATE=0.001
SENDSTACK_HEALTH_MAX_UNSUBSCRIBE_RATE=0.02
SENDSTACK_HEALTH_MAX_DELAY_RATE=0.2
SENDSTACK_HEALTH_MAX_FAILURE_RATE=0.05
SENDSTACK_EMERGENCY_STOP=false

SENDSTACK_LIVE_SEND_ENABLED=false
SENDSTACK_COOKIE_SECURE=false
SENDSTACK_SESSION_HOURS=12
SENDSTACK_DAILY_LIMIT=50
SENDSTACK_ADMIN_EMAIL=admin@sendstack.local
SENDSTACK_ADMIN_PASSWORD=ChangeMe123!

# Optional until live send / webhooks are unlocked
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Required before live send: authenticates GET /api/cron/launch-jobs
# External scheduler must hit that endpoint every minute (vercel.json has no cron).
CRON_SECRET=
