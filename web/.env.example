# Copy to .env for local development (sandbox). Never commit real secrets.
# Optional disposable test DB (never falls back to DATABASE_URL):
# SENDSTACK_TEST_DATABASE_URL=postgresql://sendstack:sendstack@127.0.0.1:55432/sendstack_test

DATABASE_URL=postgresql://sendstack:sendstack@127.0.0.1:5432/sendstack

SENDSTACK_PUBLIC_URL=http://localhost:3000
SENDSTACK_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# For live Spacemail SMTP, FROM must match SENDSTACK_SMTP_USERNAME (the mailbox).
SENDSTACK_FROM_EMAIL=news@example.com
# Optional — not forced onto every outbound message:
# SENDSTACK_REPLY_TO_EMAIL=hello@example.com
# SENDSTACK_ALLOWED_LINK_DOMAINS=example.com,www.example.com

SENDSTACK_LIVE_SEND_ENABLED=false
SENDSTACK_DELIVERY_MODE=sandbox
SENDSTACK_DAILY_LIMIT=50

SENDSTACK_ADMIN_EMAIL=admin@sendstack.local
SENDSTACK_ADMIN_PASSWORD=ChangeMe123!

# --- Production / live send (Vercel Production only; not for Preview) ---
# Each list address is one ordinary SMTP message from the Spacemail mailbox.
# SENDSTACK_TEST_RECIPIENT_ALLOWLIST=ops@example.com
# SENDSTACK_LIVE_SEND_ENABLED=true
# SENDSTACK_DELIVERY_MODE=smtp
# SENDSTACK_SMTP_HOST=mail.spacemail.com
# SENDSTACK_SMTP_PORT=465
# SENDSTACK_SMTP_USERNAME=news@example.com
# SENDSTACK_SMTP_PASSWORD=
# SENDSTACK_IMAP_HOST=mail.spacemail.com
# SENDSTACK_IMAP_PORT=993
# CRON_SECRET=
